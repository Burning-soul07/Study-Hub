/* ===================== DONUT CHART ===================== */

class AttendancePainter extends CustomPainter {
  final double attendancePercent;
  AttendancePainter({required this.attendancePercent});

  @override
  void paint(Canvas canvas, Size size) {
    Paint p = Paint()
      ..style = PaintingStyle.stroke
      ..strokeWidth = 18;

    double c = size.width / 2;
    double r = (size.width - p.strokeWidth) / 2;

    p.color = Colors.orange;
    canvas.drawArc(
      Rect.fromCircle(center: Offset(c, c), radius: r),
      -pi / 2,
      2 * pi,
      false,
      p,
    );

    p.color = Colors.green;
    canvas.drawArc(
      Rect.fromCircle(center: Offset(c, c), radius: r),
      -pi / 2,
      2 * pi * attendancePercent,
      false,
      p,
    );
  }

  @override
  bool shouldRepaint(CustomPainter oldDelegate) => false;
}
